# ============================================
# IBCP-SCADA Backend environment example
# Copy to .env and fill real values. NEVER commit .env
# ============================================

# Environment: development | production
ENVIRONMENT=development

# PostgreSQL (Docker PostGIS on 5433 - DEV ONLY)
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5433/ibcp_scada

# Redis / MQTT
REDIS_URL=redis://localhost:6379
MQTT_BROKER=localhost
MQTT_PORT=1883

# JWT - generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public registration: keep False. Only enable for local development.
ALLOW_PUBLIC_REGISTRATION=false

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GEE (optional)
GEE_PROJECT=