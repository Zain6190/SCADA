# AquaVision service - environment template
# Primary DB is Neon: copy the connection string from the Neon console into
# DATABASE_URL (also settable once in the repo-root .env used by docker compose).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
DB_ECHO=false
# Ping the DB every DB_KEEPALIVE_SECONDS so Neon never auto-suspends. Waking a
# suspended compute costs ~65s. Set false to let it sleep (saves compute-hours
# on the free tier, at the cost of a slow first request after 5 min idle).
DB_KEEPALIVE=true
DB_KEEPALIVE_SECONDS=120
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# JWT Auth (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@ibcp-scada.pk
SMTP_PASSWORD=change-me
ALERT_RECIPIENTS=admin@ibcp-scada.pk,ops@ibcp-scada.pk

# GloFAS backfill (scripts/backfill_glofas.py) — free token from
# https://cds.climate.copernicus.eu profile, dataset terms accepted once.
EWDS_API_URL=https://ewds.climate.copernicus.eu/api
EWDS_API_TOKEN=
