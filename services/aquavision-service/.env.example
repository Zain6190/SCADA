# AquaVision service - environment template
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5433/ibcp_scada
DB_ECHO=false
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# JWT Auth (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@ibcp-scada.pk
SMTP_PASSWORD=change-me
ALERT_RECIPIENTS=admin@ibcp-scada.pk,ops@ibcp-scada.pk
