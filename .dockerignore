# Keep build context small and secrets out of images.
.git
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.env
**/.env.local
**/*.pdf
**/*.zip
**/.pytest_cache
**/.coverage
**/node_modules
**/.next
**/out
packages/dashboard/out
services/aquavision-service/data/raw/real/irsa/*.pdf
services/aquavision-service/infrastructure/ingestion/raw_archive

# shrink frontend build context
*.pdf
*.zip
*.csv
docs
session-log.md
data
**/*.joblib
# trained model artifacts must ship in the image (no volume mounts; serving
# reads /ml-pipeline/models/artifacts at runtime)
!services/ml-pipeline/models/**/*.joblib
**/*.pkl
**/*.png
**/*.jpg
