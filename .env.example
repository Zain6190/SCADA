# IBCP-SCADA Environment Configuration
# Copy this to .env and update values

# Database
POSTGRES_PASSWORD=1234

# JWT Authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# SMTP (optional — for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENTS=
