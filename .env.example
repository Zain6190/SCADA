# IBCP-SCADA Environment Configuration
# Copy this to `.env` (gitignored) and fill in real values, then share the
# filled file with teammates — never commit real credentials (repo is public).
#
# Database setup (Neon — https://console.neon.tech):
#   1. Create a project -> copy the connection string of the direct endpoint
#      (host WITHOUT "-pooler" unless you specifically need pooling).
#   2. Paste it as DATABASE_URL below, keeping ?sslmode=require.
#   3. First run: restore the schema+data with pg_dump (see README
#      "Database (Neon)") or build it up with db/setup_neon.py + db/seed_neon.py.
#
# Optional local fallback: set DATABASE_URL to
#   postgresql://postgres:1234@localhost:5433/ibcp_scada
# and run the compose `db` service (docker compose up -d db).

# ── Database (REQUIRED — primary is Neon) ────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require

# Only used by the OPTIONAL local fallback DB (compose service "db")
POSTGRES_PASSWORD=1234

# ── JWT Authentication (generate with: openssl rand -hex 32) ────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── SMTP (optional — for email alerts) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# ── Frontend build arg (browser reaches the API on localhost) ────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100

# ── Google Earth Engine (P5 feature pipeline) ────────────────────────
# GCP project with the Earth Engine API enabled (ee.Initialize(project=...)
GEE_PROJECT=
# Host directory mounted read-only at /root/.config/earthengine
GEE_CREDENTIALS_DIR=C:/Users/YOUR_USER/.config/earthengine
